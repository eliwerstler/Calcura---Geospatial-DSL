// testing nested if-else
let num = 10;
if (num > 5) {
  if (num < 15) {
    // within range
    print("within range");
  }
  else {
    print("too high");
  }
}
else {
  print("too low");
}

let x = 10;
let y = 11;

if (x <= 11) {
  // 10
  print(x);
}

if (x >= 10) {
  // true
  print("true");
}

if (x <= 19) {
  // true
  print("true");
}

if (x == 10) {
  // yes
  print("yes");
}

if (y == 11) {
  // yes
  print("yes");
}

if (y != 3) {
  // yes
  print("yes");
}

if (true and true) {
  // yes
  print("yes");
}

if (false or true) {
  // yes
  print("yes");
}

if (not not true) {
  // yes
  print("yes");
}

if (not x == 1) {
  // yes
  print("yes");
}

