// This is a unit test file. All print statements must have a comment
// on the line above them with the expected value for that print.
// See README for more info.

// simple add function
func add(x, y) {
  return x + y;
}

// 5
print(add(2, 3));  

// test squaring
func square(n) {
  return n * n;
}

// 16
print(square(4));

// chaining calls
// 7
print(add(square(2), 3));

func sum_squares(a, b) {
  let x = square(a);
  let y = square(b);
  return add(x, y);
}

// 13
print(sum_squares(2,3));

func plus_one(x) {
  return x + 1;
}
let incremented = map([1, 2, 3], plus_one);
// [2, 3, 4]
print(incremented);

func greater_than_one(x) {
  return x > 1;
}

let filtered_gt_one = filter([1, 2, 3], greater_than_one);
// [2, 3]
print(filtered_gt_one);

