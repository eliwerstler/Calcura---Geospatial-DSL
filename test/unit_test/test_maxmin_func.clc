// 6
print(max([6, 4, 2]));

// -1
print(min([0, -1, 2]));

// 9
print(max([9, 9, 9]));

// -100
print(min([-10, -20, -100]));

// 0
print(max([-1, 0, -2]));

// 42
print(max([42]));

// 42
print(min([42]));

// 1000
print(max([1000, 100, 10, 1]));

// 1
print(min([1000, 100, 10, 1]));

// 5
print(max([1, 3, 5, 2, 4]));

// 1
print(min([1, 3, 5, 2, 4]));
