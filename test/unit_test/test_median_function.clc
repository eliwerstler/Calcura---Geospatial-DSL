// This is a unit test file. All print statements must have a comment
// on the line above them with the expected value for that print.
// See README for more info.

// 2.0
print(median([1, 3, 2]));

// 2.5
print(median([1, 2, 3, 4]));

// 2.5
print(median([2.5, 1.5, 3.5]));

// 2.8
print(median([1.2, 3.4, 2.2, 4.6]));

// 0.0
print(median([]));

// 42.0
print(median([42]));

// 7.7
print(median([7.7]));

// 30.0
print(median([10, 20, 30, 40, 50]));

// 7.5
print(median([10, 0, 5, 15]));

// 3.0
print(median([5, 1, 5, 1]));
