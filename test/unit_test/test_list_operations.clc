// This is a unit test file. All print statements must have a comment
// on the line above them with the expected value for that print.
// See README for more info.

// Access an item from a list
let nums = [10, 20, 30, 40];
let second = nums[1];
//20
print(second);

let float_nums = [1.0, -13.4, 8.6, 4.0, 4.9];
let second_num = float_nums[1];
// -13.4
print(second_num);

let floater_nums = [-1.0, -13.4, 8.6, 4.0, 4.9];
floater_nums[0] = 5.5;
// 5.5
print(floater_nums[0]);

// --- Swap tests ---
let swap_nums = swap([1, 2, 3, 4, 5], 1, 3);
// [1, 4, 3, 2, 5]
print(swap_nums);

let swap_floats = swap([1.1, 2.2, 3.3], 0, 2);
// [3.3, 2.2, 1.1]
print(swap_floats);

// --- Reverse tests ---
let rev_nums = reverse([1, 2, 3, 4, 5]);
// [5, 4, 3, 2, 1]
print(rev_nums);

let rev_floats = reverse([1.1, 2.2, 3.3]);
// [3.3, 2.2, 1.1]
print(rev_floats);
