// Unit tests for loops in Calcura
// Each test is followed by a commented expected output

// --- Basic while loop test ---
let i = 0;
let sum = 0;

while (i < 5) {
  sum = sum + i;
  i = i + 1;
}
// 10
print(sum);

// --- Basic for-in loop test (Python style) ---
let list_sum = 0;
for (n in [1, 2, 3, 4, 5]) {
  list_sum = list_sum + n;
}
// 15
print(list_sum);

// --- Basic C-style for loop test ---
let c_sum = 0;
for (let j = 0; j < 5; j = j + 1) {
  c_sum = c_sum + j;
}
// 10
print(c_sum);

// --- While loop with break ---
let break_sum = 0;
let k = 0;
while (k < 10) {
  if (k == 5) {
    break;
  }
  break_sum = break_sum + k;
  k = k + 1;
}
// 10
print(break_sum);

// --- For-in loop with continue ---
let even_sum = 0;
for (x in [1, 2, 3, 4, 5, 6]) {
  // Make sure x is treated as an integer for modulo operation
  let remainder = x % 2;
  if (remainder == 1) {
    continue;
  }
  even_sum = even_sum + x;
}
// 12
print(even_sum);

// --- C-style for loop with break and continue ---
let special_sum = 0;
for (let p = 0; p < 10; p = p + 1) {
  if (p == 8) {
    break;
  }
  // Make sure p is treated as an integer for modulo operation
  let mod3 = p % 3;
  if (mod3 == 0) {
    continue;
  }
  special_sum = special_sum + p;
}
// 19
print(special_sum);

// --- Nested loops with break ---
let outer_result = 0;
for (let outer = 0; outer < 5; outer = outer + 1) {
  let inner_sum = 0;
  for (let inner = 0; inner < 3; inner = inner + 1) {
    if (outer == 3 && inner == 1) {
      break;
    }
    inner_sum = inner_sum + inner;
  }
  outer_result = outer_result + inner_sum;
}
// 25
print(outer_result);

// --- While loop with continue ---
let m = 0;
let continue_sum = 0;
while (m < 10) {
  m = m + 1;
  let is_even = m % 2;
  if (is_even == 0) {
    continue;
  }
  continue_sum = continue_sum + m;
}
// 25
print(continue_sum);