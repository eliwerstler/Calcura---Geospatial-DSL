let columbia_lat_lon = (40.8045, -73.9572);
// (587960.42, 4517578.19)
print(transform(columbia_lat_lon, from=WGS84, to=UTM));

let columbia_UTM = (587960.42, 4517578.19);
// (40.8045, -77.9818)
print(transform(columbia_UTM, from=UTM, to=WGS84));