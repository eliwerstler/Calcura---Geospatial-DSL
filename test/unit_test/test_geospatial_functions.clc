// This is a unit test file. All print statements must have a comment 
// on the line above them with the expected value for that print.
// See README for more info.

let decimals = (3.1, 2.1);

// (2.1, 1.1)
print(transform(decimals, from=UTM, to=WGS84));

// (4.1, 3.1)
print(transform(decimals, from=WGS84, to=UTM));

// (2.1, 1.1)
print(transform((3.1, 2.1), from=UTM, to=WGS84));

// (4.1, 3.1)
print(transform((3.1, 2.1), from=WGS84, to=UTM));

