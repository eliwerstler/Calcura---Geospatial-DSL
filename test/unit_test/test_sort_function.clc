// This is a unit test file. All print statements must have a comment
// on the line above them with the expected value for that print.
// See README for more info.

// [1, 2, 3]
print(sort([3, 1, 2])); // Default ascending

// [3.1, 4.5]
print(sort([4.5, 3.1])); // Default ascending

// [1.1, 2.2, 3.3]
print(sort([3.3, 1.1, 2.2])); // Default ascending

// [3.3, 2.2, 1.1]
print(sort([1.1, 2.2, 3.3], false));

// []
print(sort([], true));

// [42]
print(sort([42], true));

// [1, 2, 3]
print(sort([1, 2, 3], true));

// [1, 2, 3]
print(sort([3, 2, 1], true));

// [3, 2, 1]
print(sort([1, 2, 3], false));

// [1.5, 2.5, 3.5]
print(sort([3.5, 1.5, 2.5], true));

// [3.5, 2.5, 1.5]
print(sort([1.5, 2.5, 3.5], false));

// [1, 2, 2, 3, 3]
print(sort([3, 2, 3, 1, 2], true));

// [3.3, 3.3, 2.2, 1.1]
print(sort([1.1, 3.3, 2.2, 3.3], false));